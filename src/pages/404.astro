---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
      <nav
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-foreground/70"
        aria-label="Popular destinations"
      >
        <LinkButton
          href="/posts"
          class="underline decoration-dashed underline-offset-4"
        >
          Posts
        </LinkButton>
        <LinkButton
          href="/search"
          class="underline decoration-dashed underline-offset-4"
        >
          Search
        </LinkButton>
        <LinkButton
          href="/media"
          class="underline decoration-dashed underline-offset-4"
        >
          Media
        </LinkButton>
        <LinkButton
          href="/"
          class="underline decoration-dashed underline-offset-4"
        >
          Home
        </LinkButton>
      </nav>
    </div>
  </main>

  <Footer />
</Layout>
