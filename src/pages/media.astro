---

<Layout title={`Media | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <section class="pt-10 sm:pt-14">
      <h1 class="text-2xl font-bold sm:text-3xl">Media</h1>
      <p class="mt-1 text-sm opacity-60">
        Talks, podcasts, press, and writing, from 2016 to now. Lately most of it
        is about agentic AI and web data.
      </p>

      <!-- Talks -->
      <div class="mt-10 border-t border-border pt-8">
        <h2
          id="talks"
          class="text-xl font-[var(--font-jetbrains-mono)] font-bold text-accent"
        >
          Talks
        </h2>
        <ul class="mt-4 space-y-5">
          {
            talks.map(entry => (
              <li>
                <p class="font-medium">{entry.title}</p>
                <p class="mt-0.5 text-sm opacity-60">
                  {entry.venue} &middot; {entry.date}
                </p>
                <div class="mt-1.5 flex flex-wrap gap-2">
                  {entry.links.map(link => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded border border-border px-2 py-0.5 text-xs transition-colors hover:border-accent hover:text-accent"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Podcasts -->
      <div class="mt-10 border-t border-border pt-8">
        <h2
          id="podcasts"
          class="text-xl font-[var(--font-jetbrains-mono)] font-bold text-accent"
        >
          Podcasts
        </h2>
        <ul class="mt-4 space-y-5">
          {
            podcasts.map(entry => (
              <li>
                <p class="font-medium">{entry.title}</p>
                <p class="mt-0.5 text-sm opacity-60">
                  {entry.venue} &middot; {entry.date}
                </p>
                <div class="mt-1.5 flex flex-wrap gap-2">
                  {entry.links.map(link => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded border border-border px-2 py-0.5 text-xs transition-colors hover:border-accent hover:text-accent"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Press -->
      <div class="mt-10 border-t border-border pt-8">
        <h2
          id="press"
          class="text-xl font-[var(--font-jetbrains-mono)] font-bold text-accent"
        >
          Press
        </h2>
        <ul class="mt-4 space-y-5">
          {
            press.map(entry => (
              <li>
                <p class="font-medium">{entry.title}</p>
                <p class="mt-0.5 text-sm opacity-60">
                  {entry.venue} &middot; {entry.date}
                </p>
                <div class="mt-1.5 flex flex-wrap gap-2">
                  {entry.links.map(link => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded border border-border px-2 py-0.5 text-xs transition-colors hover:border-accent hover:text-accent"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Writing -->
      <div class="mt-10 border-t border-border pt-8">
        <h2
          id="writing"
          class="text-xl font-[var(--font-jetbrains-mono)] font-bold text-accent"
        >
          Writing
        </h2>
        {
          writingByYear.map((group, index) => (
            <div
              class:list={[
                "pt-6",
                { "mt-6 border-t border-border": index > 0 },
              ]}
            >
              <span class="text-lg font-[var(--font-jetbrains-mono)] font-bold text-accent">
                {group.year}
              </span>
              <sup class="text-xs opacity-60">{group.entries.length}</sup>
              <ul class="mt-3 space-y-5">
                {group.entries.map(entry => (
                  <li>
                    <p class="font-medium">{entry.title}</p>
                    <p class="mt-0.5 text-sm opacity-60">
                      {entry.venue} &middot; {entry.date}
                    </p>
                    <div class="mt-1.5 flex flex-wrap gap-2">
                      {entry.links.map(link => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded border border-border px-2 py-0.5 text-xs transition-colors hover:border-accent hover:text-accent"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
