---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import SortToggle from "@/components/SortToggle.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts, "published");
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Hero stats (sourced from public/resume/index.html and src/pages/media.astro)
const heroStats = [
  { value: "10+", label: "Years shipping" },
  { value: "48", label: "Guest articles" },
  { value: "21", label: "Talks and podcasts" },
  { value: "100K+", label: "Developers reached" },
];

// "Last shipped" build-time status strip, computed from the latest published post
const SHORT_MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const latestPost = sortedPosts[0];
const latestPostUrl = latestPost
  ? getPath(latestPost.id, latestPost.filePath)
  : null;
const latestPostDate = latestPost
  ? (() => {
      const d = new Date(latestPost.data.pubDatetime);
      return `${d.getUTCDate()} ${SHORT_MONTHS[d.getUTCMonth()]}`;
    })()
  : null;

// Metadata for all non-featured posts (used by client-side sort toggle)
const allNonFeaturedMeta = recentPosts.map(p => ({
  title: p.data.title,
  url: getPath(p.id, p.filePath),
  description: p.data.description,
  pubDatetime: p.data.pubDatetime.toISOString(),
  modDatetime: p.data.modDatetime?.toISOString() ?? null,
  ogImage: typeof p.data.ogImage === "string" ? p.data.ogImage : null,
}));
---

<Layout pageType="home">
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-post-per-index={SITE.postPerIndex}
    class="mx-auto w-full max-w-app-wide px-4"
  >
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <div class="w-full">
        <span
          class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/5 px-3 py-1 text-xs font-[var(--font-jetbrains-mono)] text-accent"
        >
          <span class="size-1.5 rounded-full bg-accent"></span>
          Building AI Agents in public
        </span>
        <div class="my-4 flex items-center gap-4 sm:my-6">
          <img
            src="/optimized/assets/images/avatar.webp"
            alt="Ayan Pahwa"
            width="80"
            height="80"
            class="size-16 rounded-full object-cover shadow-[0_0_24px_-6px_var(--accent)] ring-2 ring-accent/30 sm:size-20"
          />
          <div class="flex items-center gap-3">
            <h1 class="inline-block text-3xl font-bold sm:text-5xl">
              Ayan Pahwa
            </h1>
            <a
              target="_blank"
              href="/rss.xml"
              class="inline-block"
              aria-label="rss feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="scale-125 stroke-accent stroke-3"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
        </div>
        <p
          class="mb-4 max-w-2xl text-sm leading-relaxed text-foreground/70 sm:text-base"
        >
          I'm a Developer Advocate who builds agentic AI systems in public and
          writes about the web-data layer they run on. Away from the keyboard
          I'm a coffee nerd, an everyday-carry obsessive, and a dad of two,
          running more parallel expensive hobbies than is probably sensible.
        </p>
        <div class="grid w-full grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
          {
            heroStats.map(stat => (
              <div class="rounded-lg border border-border bg-muted/50 px-3 py-2.5 text-center">
                <div class="text-lg font-[var(--font-jetbrains-mono)] font-bold text-foreground sm:text-xl">
                  {stat.value}
                </div>
                <div class="mt-0.5 text-[10px] tracking-wide text-foreground/55 uppercase">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>
        {
          SOCIALS.length > 0 && (
            <div class="mt-5">
              <Socials />
            </div>
          )
        }
        {
          latestPost && (
            <p class="mt-4 text-xs text-foreground/50">
              Last shipped:{" "}
              <a
                href={latestPostUrl}
                class="text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                {latestPost.data.title}
              </a>{" "}
              ({latestPostDate})
            </p>
          )
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <div class="flex items-baseline gap-3">
            <h2 class="text-2xl font-semibold tracking-wide">
              📌 Pinned Blogs
            </h2>
            <span class="text-foreground/30">|</span>
            <a
              href="/series"
              class="text-sm font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              Blog Series
            </a>
          </div>
          <ul>
            {featuredPosts.slice(0, 4).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <div class="mb-1 flex items-center justify-between">
            <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
            <SortToggle />
          </div>
          <ul id="recent-posts-list">
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div
      id="non-featured-meta"
      data-posts={JSON.stringify(allNonFeaturedMeta)}
      hidden
    >
    </div>

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.author,
    jobTitle: "Developer Advocate",
    url: `${SITE.website}about/`,
    image: `${SITE.website}optimized/assets/images/avatar.webp`,
    description: SITE.desc,
    sameAs: [
      "https://github.com/iAyanPahwa",
      "https://x.com/apxtweets",
      "https://linkedin.com/in/iAyanPahwa",
      "https://orcid.org/0009-0001-7765-7735",
    ],
  })}
/>

<script>
  const MONTHS = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];

  function formatDate(iso: string) {
    const d = new Date(iso);
    return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}, ${d.getUTCFullYear()}`;
  }

  function renderCard(
    p: {
      title: string;
      url: string;
      description: string;
      pubDatetime: string;
      modDatetime: string | null;
      ogImage: string | null;
    },
    sortBy: string
  ) {
    const isModified =
      sortBy === "modified" &&
      p.modDatetime != null &&
      p.modDatetime > p.pubDatetime;
    const displayDate = formatDate(isModified ? p.modDatetime! : p.pubDatetime);
    const thumbnail = p.ogImage
      ? `<img src="${p.ogImage}" alt="" width="80" height="80" loading="lazy" class="size-20 rounded-lg object-cover" />`
      : `<div aria-hidden="true" class="flex size-20 items-center justify-center rounded-lg bg-muted text-2xl font-[var(--font-jetbrains-mono)] font-bold text-accent">${p.title.charAt(0).toUpperCase()}</div>`;
    return `<li class="my-6 flex items-start gap-4">
      <div class="hidden shrink-0 sm:block">${thumbnail}</div>
      <div class="min-w-0 flex-1">
        <a href="${p.url}" class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline">
          <h3>${p.title}</h3>
        </a>
        <div class="flex items-center gap-x-2 opacity-80">
          ${isModified ? '<span class="text-sm">Updated:</span>' : ""}
          <time class="text-sm">${displayDate}</time>
        </div>
        <p>${p.description}</p>
      </div>
    </li>`;
  }

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const metaEl = document.getElementById(
      "non-featured-meta"
    ) as HTMLElement | null;
    if (!metaEl) return;

    const allPosts: {
      title: string;
      url: string;
      description: string;
      pubDatetime: string;
      modDatetime: string | null;
      ogImage: string | null;
    }[] = JSON.parse(metaEl.dataset.posts ?? "[]");

    const mainEl = document.querySelector("#main-content") as HTMLElement;
    const postPerIndex = parseInt(mainEl?.dataset?.postPerIndex ?? "5");

    document.addEventListener("sort-change", (e: Event) => {
      const sortBy = (e as CustomEvent<string>).detail;
      const list = document.getElementById("recent-posts-list");
      if (!list) return;

      const sorted = [...allPosts].sort((a, b) => {
        const da =
          sortBy === "modified"
            ? new Date(a.modDatetime ?? a.pubDatetime).getTime()
            : new Date(a.pubDatetime).getTime();
        const db =
          sortBy === "modified"
            ? new Date(b.modDatetime ?? b.pubDatetime).getTime()
            : new Date(b.pubDatetime).getTime();
        return db - da;
      });

      list.innerHTML = sorted
        .slice(0, postPerIndex || 5)
        .map(p => renderCard(p, sortBy))
        .join("");
    });
  });
</script>
