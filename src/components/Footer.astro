---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "Posts", href: "/posts" },
  { label: "Media", href: "/media" },
  { label: "Series", href: "/series" },
  { label: "Links", href: "/links" },
  { label: "Now", href: "/now" },
  { label: "Archives", href: "/archives" },
  { label: "RSS", href: "/rss.xml" },
];

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-t border-border pt-6 sm:pt-4">
    <nav
      class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs font-[var(--font-jetbrains-mono)] tracking-wider text-foreground/50 uppercase"
      aria-label="Footer"
    >
      {
        footerLinks.map(link => (
          <a href={link.href} class="hover:text-accent">
            {link.label}
          </a>
        ))
      }
    </nav>
    <div
      class:list={[
        "py-6 sm:py-4",
        "flex flex-col items-center justify-between sm:flex-row-reverse",
      ]}
    >
      <Socials />
      <div
        class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row"
      >
        <span>Copyright &#169; {currentYear}</span>
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
