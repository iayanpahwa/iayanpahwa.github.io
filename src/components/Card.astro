---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, featured, series, seriesPart, ogImage, ...props } =
  data;
---

<li
  class:list={[
    "my-6 flex items-start gap-4",
    { "rounded-lg border border-accent/20 bg-muted/40 p-4": featured },
  ]}
>
  <div class="hidden shrink-0 sm:block">
    {
      ogImage ? (
        <img
          src={ogImage}
          alt=""
          width="80"
          height="80"
          loading="lazy"
          class="size-20 rounded-lg object-cover"
        />
      ) : (
        <div
          aria-hidden="true"
          class="flex size-20 items-center justify-center rounded-lg bg-muted text-2xl font-[var(--font-jetbrains-mono)] font-bold text-accent"
        >
          {title.charAt(0).toUpperCase()}
        </div>
      )
    }
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-2">
      <a
        href={getPath(id, filePath)}
        class:list={[
          "inline-block text-lg font-medium text-accent",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        >
          {title}
        </Heading>
      </a>
      {
        featured && (
          <span class="rounded border border-accent/40 bg-accent/15 px-1.5 py-0.5 font-mono text-xs leading-none font-semibold text-accent">
            pinned
          </span>
        )
      }
      {
        series && (
          <span class="rounded border border-border px-1.5 py-0.5 font-mono text-xs leading-none font-medium text-foreground/60">
            {series}
            {seriesPart ? ` · ${seriesPart}` : ""}
          </span>
        )
      }
    </div>
    <Datetime {...props} />
    <p>{description}</p>
  </div>
</li>
